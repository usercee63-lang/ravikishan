# Copy this file to .env and fill in your real values.
# NEVER commit .env to the repository.

PORT=5000

# Generate strong secrets, e.g. with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

SESSION_SECRET=change_me_to_another_long_random_string

NODE_ENV=development

# PostgreSQL connection string (Neon: create a project at neon.tech, copy
# the connection string from the dashboard). SSL is handled via PG_SSL below.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>

# Set PG_SSL=false only for local PostgreSQL without TLS
PG_SSL=true

# Optional connection tuning
PG_CONNECT_TIMEOUT_MS=8000
PG_MAX_RETRIES=5
PG_RETRY_DELAY_MS=1000

# Optional: comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# OpenRouter API key - get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

OPENROUTER_MODEL=deepseek/deepseek-chat

# Comma-separated list of admin emails (can manage access requests)
ADMIN_EMAILS=admin@example.com
