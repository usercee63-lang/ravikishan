# Copy this file to .env and fill in your real values.
# NEVER commit .env to the repository.

PORT=5000

# Generate strong secrets, e.g. with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

SESSION_SECRET=change_me_to_another_long_random_string

NODE_ENV=development

# MongoDB connection string (use credentials from your Atlas cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<cluster>

# Optional: comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# OpenRouter API key - get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

OPENROUTER_MODEL=deepseek/deepseek-chat

# Optional connection tuning
MONGO_CONNECT_TIMEOUT_MS=8000
MONGO_MAX_RETRIES=5
MONGO_RETRY_DELAY_MS=1000
